generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum UserRole {
  CUSTOMER
  PROVIDER
  STAFF
  ADMIN
}

enum ShiftType {
  MORNING
  EVENING
  FULL
}

enum PropertyType {
  FARM
  HALL
  DECORATION
}

enum BookingMode {
  FULL_DAY
  SHIFTS
  HYBRID
}

enum PriceRuleType {
  WEEKDAY
  DATE_RANGE
}

enum PropertyStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MANUAL
  ZAIN_CASH
  QI_CARD
}

enum DiscountType {
  PERCENT
  FIXED
}

enum MediaType {
  IMAGE
  VIDEO
  REEL
  PANORAMA
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  REJECTED
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  BOOKING_NEW
  BOOKING_STATUS
  PAYMENT_PROOF
  PAYMENT_RECEIVED
  REVIEW_NEW
  PROPERTY_PENDING
  SYSTEM
  MESSAGE
  OFFER
  INVOICE
  REFUND_REQUEST
  SOCIAL
}

enum BookingOrigin {
  PLATFORM
  EXTERNAL
}

enum ConversationKind {
  BOOKING
  SUPPORT
}

enum MessageKind {
  TEXT
  IMAGE
  SYSTEM
  CALL
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
  REFUNDED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CollectionVisibility {
  PRIVATE
  PUBLIC
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SocialPostStatus {
  PUBLISHED
  HIDDEN
  REPORTED
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  pinHash   String?  @map("pin_hash")
  role      UserRole @default(CUSTOMER)
  avatar    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  provider         Provider?
  bookings         Booking[]
  reviews          Review[]
  media            Media[]
  createdProperties Property[] @relation("PropertyCreatedBy")
  adminActivities  AdminActivity[]
  bookingNotes     BookingNote[]
  refreshTokens    RefreshToken[]
  deviceTokens     DeviceToken[]
  favorites        Favorite[]
  conversationParts ConversationParticipant[]
  sentMessages     Message[]
  cancellationRequests CancellationRequest[]
  reviewedCancellations CancellationRequest[] @relation("CancellationReviewer")
  refundRequests   RefundRequest[]
  reviewedRefunds  RefundRequest[] @relation("RefundReviewer")
  collections      Collection[]
  follows          ProviderFollow[]
  receivedOffers   PriceOffer[] @relation("OfferCustomer")
  createdOffers    PriceOffer[] @relation("OfferCreatedBy")
  socialPosts      SocialPost[]
  postLikes        SocialPostLike[]
  postComments     SocialPostComment[]
  postReports      SocialPostReport[]
  notifications    UserNotification[]
  guestConversations Conversation[] @relation("ConversationGuest")
  callsMade        CallSession[] @relation("CallCaller")
  callsReceived    CallSession[] @relation("CallCallee")

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Provider {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String?   @map("business_name")
  verified        Boolean   @default(false)
  kycStatus       KycStatus @default(UNVERIFIED) @map("kyc_status")
  rejectionReason String?   @map("rejection_reason")
  requestNote     String     @default("") @map("request_note")
  placeTypes      String     @default("") @map("place_types")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  properties Property[]
  followers  ProviderFollow[]
  offers     PriceOffer[]

  @@map("providers")
}

model Province {
  id     String @id @default(uuid())
  nameAr String @map("name_ar")
  nameEn String @map("name_en")
  slug   String @unique
  cities City[]

  @@map("provinces")
}

model City {
  id         String   @id @default(uuid())
  provinceId String   @map("province_id")
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  nameAr     String   @map("name_ar")
  nameEn     String   @map("name_en")
  slug       String

  properties Property[]

  @@unique([provinceId, slug])
  @@map("cities")
}

model Property {
  id            String         @id @default(uuid())
  providerId    String?        @map("provider_id")
  provider      Provider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  createdById   String?        @map("created_by_id")
  createdBy     User?          @relation("PropertyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  type          PropertyType
  slug          String         @unique
  name          String
  nameEn        String         @default("") @map("name_en")
  description   String         @default("")
  descriptionEn String         @default("") @map("description_en")
  metaTitle     String         @default("") @map("meta_title")
  metaDescription String       @default("") @map("meta_description")
  cityId        String         @map("city_id")
  city          City           @relation(fields: [cityId], references: [id])
  address       String?
  latitude      Decimal        @db.Decimal(10, 7)
  longitude     Decimal        @db.Decimal(10, 7)
  capacity      Int            @default(0)
  bookingMode   BookingMode?   @map("booking_mode")
  morningStart  String?        @map("morning_start")
  morningEnd    String?        @map("morning_end")
  eveningStart  String?        @map("evening_start")
  eveningEnd    String?        @map("evening_end")
  pricePerDay   Decimal        @map("price_per_day") @db.Decimal(12, 2)
  weekendPrice  Decimal?       @map("weekend_price") @db.Decimal(12, 2)
  priceMorningShift Decimal?   @map("price_morning_shift") @db.Decimal(12, 2)
  priceEveningShift Decimal?   @map("price_evening_shift") @db.Decimal(12, 2)
  phone         String?
  whatsapp      String?
  featured      Boolean        @default(false)
  isNew         Boolean        @default(false) @map("is_new")
  amenities     Json           @default("[]")
  tags          Json           @default("[]")
  rules         String         @default("")
  internalNotes String         @default("") @map("internal_notes")
  status        PropertyStatus @default(DRAFT)
  rejectionReason String?      @map("rejection_reason")
  viewCount     Int            @default(0) @map("view_count")
  ratingAvg     Decimal        @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount   Int            @default(0) @map("rating_count")
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  media             Media[]
  availabilitySlots AvailabilitySlot[]
  priceRules        PriceRule[]
  amenityLinks      PropertyAmenity[]
  favorites         Favorite[]
  coupons           Coupon[]
  bookings          Booking[]
  reviews           Review[]
  collectionItems   CollectionItem[]
  offers            PriceOffer[]
  socialPosts       SocialPost[]
  spotlights        HomeSpotlight[]
  conversations     Conversation[]

  @@index([type, status])
  @@index([cityId])
  @@index([featured])
  @@index([isNew])
  @@index([status, featured])
  @@index([providerId])
  @@index([createdAt])
  @@map("properties")
}

model Media {
  id            String      @id @default(uuid())
  propertyId    String?     @map("property_id")
  property      Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedById  String?     @map("uploaded_by_id")
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  type          MediaType   @default(IMAGE)
  status        MediaStatus @default(READY)
  url           String
  thumbnailUrl  String?     @map("thumbnail_url")
  hlsUrl        String?     @map("hls_url")
  posterUrl     String?     @map("poster_url")
  width         Int?
  height        Int?
  aspectRatio   String?     @map("aspect_ratio")
  renditions    Json?
  caption       String      @default("")
  altText       String      @default("") @map("alt_text")
  durationSec   Int?        @map("duration_sec")
  fileSizeBytes BigInt?     @map("file_size_bytes")
  mimeType      String?     @map("mime_type")
  processingProgress Int?   @map("processing_progress")
  processingError    String? @map("processing_error")
  sortOrder     Int         @default(0) @map("sort_order")
  isPrimary     Boolean     @default(false) @map("is_primary")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([propertyId, sortOrder])
  @@index([status])
  @@map("media")
}

model AvailabilitySlot {
  id            String    @id @default(uuid())
  propertyId    String    @map("property_id")
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  shift         ShiftType @default(FULL)
  isAvailable   Boolean   @default(true) @map("is_available")
  priceOverride Decimal?  @map("price_override") @db.Decimal(12, 2)

  @@unique([propertyId, date, shift])
  @@map("availability_slots")
}

model PriceRule {
  id           String        @id @default(uuid())
  propertyId   String        @map("property_id")
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String        @default("")
  ruleType     PriceRuleType @default(WEEKDAY) @map("rule_type")
  daysOfWeek   Int[]         @map("days_of_week")
  startDate    DateTime?     @map("start_date") @db.Date
  endDate      DateTime?     @map("end_date") @db.Date
  fullDayPrice Decimal?      @map("full_day_price") @db.Decimal(12, 2)
  morningPrice Decimal?      @map("morning_price") @db.Decimal(12, 2)
  eveningPrice Decimal?      @map("evening_price") @db.Decimal(12, 2)
  morningStart String?       @map("morning_start")
  morningEnd   String?       @map("morning_end")
  eveningStart String?       @map("evening_start")
  eveningEnd   String?       @map("evening_end")
  priority     Int           @default(0)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([propertyId, isActive])
  @@map("price_rules")
}

model Booking {
  id         String        @id @default(uuid())
  userId     String?       @map("user_id")
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  propertyId String        @map("property_id")
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  startDate  DateTime      @map("start_date") @db.Date
  endDate    DateTime      @map("end_date") @db.Date
  shift      ShiftType     @default(FULL)
  guests     Int           @default(1)
  status     BookingStatus @default(PENDING)
  origin     BookingOrigin @default(PLATFORM)
  guestName  String?       @map("guest_name")
  guestPhone String?      @map("guest_phone")
  totalPrice Decimal       @map("total_price") @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  couponId   String?       @map("coupon_id")
  coupon     Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  notes      String?
  disputeReason String?      @map("dispute_reason")
  disputeNote   String?      @map("dispute_note")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  payment Payment?
  couponRedemption CouponRedemption?
  bookingNotes BookingNote[]
  conversation Conversation?
  invoice Invoice?
  cancellationRequests CancellationRequest[]
  refundRequests RefundRequest[]
  offer PriceOffer?
  socialPost SocialPost?

  @@index([userId])
  @@index([propertyId, startDate, endDate])
  @@index([status])
  @@index([createdAt])
  @@index([origin])
  @@map("bookings")
}

model Payment {
  id        String        @id @default(uuid())
  bookingId String        @unique @map("booking_id")
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  method    PaymentMethod @default(MANUAL)
  amount    Decimal       @db.Decimal(12, 2)
  proofUrl  String?       @map("proof_url")
  status    PaymentStatus @default(PENDING)
  adminNote String?       @map("admin_note")
  transactionRef String?  @map("transaction_ref")
  reviewedAt DateTime?    @map("reviewed_at")
  reviewedById String?    @map("reviewed_by_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  refundRequests RefundRequest[]

  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Coupon {
  id              String         @id @default(uuid())
  code            String         @unique
  description     String         @default("")
  discountType    DiscountType   @default(PERCENT) @map("discount_type")
  discountValue   Decimal        @map("discount_value") @db.Decimal(12, 2)
  minBookingTotal Decimal?       @map("min_booking_total") @db.Decimal(12, 2)
  maxUses         Int?           @map("max_uses")
  maxUsesPerUser  Int?           @map("max_uses_per_user")
  usedCount       Int            @default(0) @map("used_count")
  startsAt        DateTime?      @map("starts_at")
  expiresAt       DateTime?      @map("expires_at")
  appliesToTypes  PropertyType[] @map("applies_to_types")
  propertyId      String?        @map("property_id")
  property        Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  redemptions CouponRedemption[]
  bookings    Booking[]

  @@index([isActive])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  bookingId      String   @unique @map("booking_id")
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model Review {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String   @default("")
  isVisible  Boolean  @default(true) @map("is_visible")
  adminNote  String?  @map("admin_note")
  createdAt  DateTime @map("created_at") @default(now())

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("reviews")
}

model Amenity {
  id        String         @id @default(uuid())
  nameAr    String         @map("name_ar")
  nameEn    String         @default("") @map("name_en")
  slug      String         @unique
  icon      String         @default("")
  category  String         @default("general")
  appliesTo PropertyType[] @map("applies_to")
  isSystem  Boolean        @default(false) @map("is_system")
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String   @map("property_id")
  amenityId  String   @map("amenity_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  value      String?
  sortOrder  Int      @default(0) @map("sort_order")

  @@unique([propertyId, amenityId])
  @@map("property_amenities")
}

model AdminActivity {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@map("admin_activities")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String   @default("")
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("banners")
}

/// أماكن مميزة في الرئيسية — صورة متحركة بحجم بانر، مربوطة بمكان، وارتفاعها من لوحة التحكم
model HomeSpotlight {
  id         String   @id @default(uuid())
  title      String   @default("")
  imageUrl   String   @map("image_url")
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  height     Int      @default(176)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@index([propertyId])
  @@map("home_spotlights")
}

model TeamNotification {
  id         String           @id @default(uuid())
  type       NotificationType
  title      String
  body       String           @default("")
  linkUrl    String?          @map("link_url")
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("team_notifications")
}

model BookingNote {
  id         String   @id @default(uuid())
  bookingId  String   @map("booking_id")
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId   String   @map("author_id")
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  isInternal Boolean  @default(true) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([bookingId, createdAt])
  @@map("booking_notes")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("device_tokens")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, propertyId])
  @@index([userId])
  @@map("favorites")
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model Conversation {
  id          String           @id @default(uuid())
  bookingId   String?          @unique @map("booking_id")
  booking     Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  propertyId  String?          @map("property_id")
  property    Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  guestUserId String?          @map("guest_user_id")
  guest       User?            @relation("ConversationGuest", fields: [guestUserId], references: [id], onDelete: SetNull)
  kind        ConversationKind @default(BOOKING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]
  calls        CallSession[]

  @@unique([guestUserId, propertyId])
  @@index([kind, updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?    @map("last_read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?      @map("sender_id")
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  kind           MessageKind  @default(TEXT)
  body           String       @default("")
  imageUrl       String?      @map("image_url")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CallSession {
  id             String     @id @default(uuid())
  conversationId String     @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  callerId       String     @map("caller_id")
  caller         User       @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId       String     @map("callee_id")
  callee         User       @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  status         CallStatus @default(RINGING)
  roomName       String     @map("room_name")
  startedAt      DateTime?  @map("started_at")
  endedAt        DateTime?  @map("ended_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([calleeId, status])
  @@map("call_sessions")
}

model Invoice {
  id         String        @id @default(uuid())
  bookingId  String        @unique @map("booking_id")
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  number     String        @unique
  status     InvoiceStatus @default(ISSUED)
  subtotal   Decimal       @db.Decimal(12, 2)
  discount   Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  currency   String        @default("IQD")
  items      Json          @default("[]")
  notes      String        @default("")
  issuedAt   DateTime      @default(now()) @map("issued_at")
  paidAt     DateTime?     @map("paid_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([status, issuedAt])
  @@map("invoices")
}

model CancellationRequest {
  id              String        @id @default(uuid())
  bookingId       String        @map("booking_id")
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason          String        @default("")
  status          RequestStatus @default(PENDING)
  expectedRefund  Decimal       @map("expected_refund") @db.Decimal(12, 2)
  adminNote       String?       @map("admin_note")
  reviewedById    String?       @map("reviewed_by_id")
  reviewedBy      User?         @relation("CancellationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([bookingId])
  @@map("cancellation_requests")
}

model RefundRequest {
  id           String        @id @default(uuid())
  bookingId    String        @map("booking_id")
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId    String?       @map("payment_id")
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String        @default("")
  amount       Decimal       @db.Decimal(12, 2)
  status       RequestStatus @default(PENDING)
  adminNote    String?       @map("admin_note")
  reviewedById String?       @map("reviewed_by_id")
  reviewedBy   User?         @relation("RefundReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?     @map("reviewed_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([bookingId])
  @@map("refund_requests")
}

model PriceOffer {
  id          String      @id @default(uuid())
  providerId  String      @map("provider_id")
  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  propertyId  String      @map("property_id")
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customerId  String      @map("customer_id")
  customer    User        @relation("OfferCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  createdById String      @map("created_by_id")
  createdBy   User        @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  shift       ShiftType   @default(FULL)
  amount      Decimal     @db.Decimal(12, 2)
  message     String      @default("")
  status      OfferStatus @default(PENDING)
  expiresAt   DateTime?   @map("expires_at")
  bookingId   String?     @unique @map("booking_id")
  booking     Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([customerId, status])
  @@index([providerId, status])
  @@map("price_offers")
}

model Collection {
  id          String               @id @default(uuid())
  userId      String               @map("user_id")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String               @default("")
  coverUrl    String?              @map("cover_url")
  isDefault   Boolean              @default(false) @map("is_default")
  visibility  CollectionVisibility @default(PRIVATE)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  items CollectionItem[]

  @@index([userId, isDefault])
  @@map("collections")
}

model CollectionItem {
  id           String     @id @default(uuid())
  collectionId String     @map("collection_id")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  propertyId   String     @map("property_id")
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  note         String     @default("")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([collectionId, propertyId])
  @@index([propertyId])
  @@map("collection_items")
}

model ProviderFollow {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, providerId])
  @@index([providerId])
  @@map("provider_follows")
}

model SocialPost {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId     String?          @unique @map("booking_id")
  booking       Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  propertyId    String           @map("property_id")
  property      Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  caption       String           @default("")
  mediaUrls     Json             @default("[]") @map("media_urls")
  status        SocialPostStatus @default(PUBLISHED)
  likesCount    Int              @default(0) @map("likes_count")
  commentsCount Int              @default(0) @map("comments_count")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  likes    SocialPostLike[]
  comments SocialPostComment[]
  reports  SocialPostReport[]

  @@index([status, createdAt])
  @@index([propertyId])
  @@map("social_posts")
}

model SocialPostLike {
  id        String     @id @default(uuid())
  postId    String     @map("post_id")
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@map("social_post_likes")
}

model SocialPostComment {
  id        String     @id @default(uuid())
  postId    String     @map("post_id")
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([postId, createdAt])
  @@map("social_post_comments")
}

model SocialPostReport {
  id        String     @id @default(uuid())
  postId    String     @map("post_id")
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String     @default("")
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@map("social_post_reports")
}

model UserNotification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String   @default("")
  linkUrl    String?  @map("link_url")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("user_notifications")
}
