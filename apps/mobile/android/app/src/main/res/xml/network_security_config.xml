<?xml version="1.0" encoding="utf-8"?>
<!--
  سياسة أمان الشبكة: كل الاتصالات مشفّرة (HTTPS/WSS) — vibesiraq.com.
  لا استثناءات للنص الصريح (أُزيل استثناء عنوان IP بعد الانتقال إلى الدومين).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
