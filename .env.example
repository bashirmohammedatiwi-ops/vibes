# =============================================================================
# VIBES — Environment variables
# Copy this file to .env and fill in values before running Docker / the API.
# =============================================================================

# --- App ---
NODE_ENV=development
APP_NAME=VIBES
APP_PORT=3000
# على الـ VPS افتح الموقع من المنفذ 6001، مثال: http://SERVER:6001
APP_URL=http://localhost:6001
ADMIN_URL=http://localhost:6001
CORS_ORIGINS=http://localhost:6001,http://localhost:3001,http://localhost:3000,http://localhost:8080

# --- Database (PostgreSQL + PostGIS) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vibes
POSTGRES_PASSWORD=vibes_dev_password
POSTGRES_DB=vibes
DATABASE_URL=postgresql://vibes:vibes_dev_password@postgres:5432/vibes?schema=public

# Local (host machine, outside Docker):
# DATABASE_URL=postgresql://vibes:vibes_dev_password@localhost:5432/vibes?schema=public

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Local (host machine, outside Docker):
# REDIS_URL=redis://localhost:6379

# --- LiveKit (صوت داخل التطبيق، المفاتيح على الخادم فقط) ---
# وضع السيرفر الحالي: سيرفر مشترك بدون دومين VIBES — الاتصال المباشر ws://
# عبر IP على منفذ 6002 (شبكة المضيف، بلا docker-proxy). TURN مُفعّل (3478/udp).
# المستقبل (عند توفر دومين + شهادة SSL): wss:// عبر بوابة TLS + TURN/TLS 5349 —
# راجع docker/nginx/README.md و nginx-tls.conf الجاهز للتفعيل.
LIVEKIT_URL=ws://187.127.88.146:6002
# عنوان السيرفر العام الذي يراه الهاتف أثناء المكالمة
LIVEKIT_NODE_IP=187.127.88.146
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_vibes_livekit_32chars

# ثواني رنين المكالمة قبل تسجيلها فائتة تلقائياً (افتراضي 45)
CALL_RINGING_TIMEOUT_SECONDS=45

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- OTP ---
OTP_EXPIRES_IN_SECONDS=300
OTP_LENGTH=6
# development (fixed ADMIN_OTP) | console (log only) | webhook | whatsapp
OTP_PROVIDER=development

# Used when OTP_PROVIDER=webhook — receives {phone, code, message} as JSON.
OTP_WEBHOOK_URL=

# Used when OTP_PROVIDER=whatsapp — WhatsApp Cloud API (Meta Graph API).
# Requires an approved "authentication" template with one {{1}} body
# placeholder for the code. Create the app + template at
# https://developers.facebook.com/apps → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=otp_verification
WHATSAPP_TEMPLATE_LANG=ar

# --- Media (local uploads for MVP) ---
MEDIA_ROOT=/app/uploads
MEDIA_PUBLIC_URL=http://localhost/media
MAX_UPLOAD_MB=20
# Video upload ceiling (independent of images) and processing driver:
MEDIA_VIDEO_MAX_MB=200
# ffmpeg = local processing inside the API container; bunny = Bunny Stream cloud
# (requires BUNNY_STREAM_* keys below — HLS + MP4 renditions + poster from Bunny CDN)
MEDIA_TRANSCODE_DRIVER=ffmpeg

# --- Payment gateways ---
# Base URL the gateway will call back on. Falls back to MEDIA_PUBLIC_URL minus /media.
API_PUBLIC_URL=http://localhost:3000
# Webhook: POST {API_PUBLIC_URL}/api/payments/callback/zain-cash
ZAIN_CASH_MERCHANT_ID=
# HMAC-SHA256 secret for the X-Signature header. Leave empty to accept unsigned (sandbox only).
ZAIN_CASH_SECRET=
# Webhook: POST {API_PUBLIC_URL}/api/payments/callback/qi-card
QI_CARD_TERMINAL_ID=
QI_CARD_SECRET=

# --- Support ---
SUPPORT_PHONE=9647700000000
PUBLIC_WEB_URL=https://vibes.iq

# --- Firebase (placeholders — Phase 2 / production) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Flutter: google-services.json / GoogleService-Info.plist

# --- Mapbox ---
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token
MAPBOX_STYLE_ID=mapbox/streets-v12

# --- Bunny Stream (فيديو عبر CDN) ---
# التفعيل: MEDIA_TRANSCODE_DRIVER=bunny + القيم الثلاث أدناه من لوحة Bunny:
#   Stream → Libraries → (مكتبتك) → API Key، و CDN Hostname من إعدادات المكتبة.
# الكود يقرأ BUNNY_STREAM_CDN_HOSTNAME (وبالاحتياط BUNNY_CDN_HOSTNAME القديم).
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOSTNAME=
# (متوافقية قديمة)
BUNNY_CDN_HOSTNAME=

# --- Cloudflare R2 (Phase 2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Admin seed (dev only) ---
ADMIN_PHONE=9647700000000
ADMIN_NAME=VIBES Admin
ADMIN_OTP=123456

# Automatic translation of server content for the English app (empty = content stays Arabic)
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-opus-5-5
